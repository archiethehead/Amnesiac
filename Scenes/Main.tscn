[sub_resource type="GDScript" id="GDScript_grg3l"]
resource_name = "DeathTrigger"
script/source = "extends EventTrigger

var is_dead: bool = false
var revive_timer: float = 3.0

func _process(delta: float) -> void:
	
	if (is_dead):
			revive_timer -= delta
			
			if (revive_timer <= 0.0):
				GameManager.RevivePlayer()	
				is_dead = false
				revive_timer = 3.0
				self.free()

func event() -> void:
	GameManager.KillPlayer()
	is_dead = true
"

